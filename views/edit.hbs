<h1 class="form-title">Редактиране на Обява</h1>
<div class="form-container">
    {{#with carPart}}
    <form action="/edit/{{id}}" method="POST" class="forms">
         <div class="form-group">
            <label for="name" class="form-label">Име</label>
            <input type="text" id="name" name="name" value="{{name}}" class="form-input" >
        </div>

        <div class="form-group">
            <label for="description" class="form-label">Описание</label>
            <textarea id="description" name="description" class="form-input" >{{description}}</textarea>
        </div>

        <div class="form-group">
            <label for="image" class="form-label">URL на изображението</label>
            <input type="text" id="image" name="imageUrl" value="{{imageUrl}}" class="form-input" >
        </div>

        <div class="form-group">
            <label for="price" class="form-label">Цена</label>
            <input type="number" id="price" name="price" value="{{price}}" class="form-input" >
        </div>

        <input type="submit" value="Запази" class="form-submit">
    </form>
    {{/with}}
</div>
